# Samarth AI Worker — Environment Variables
# Copy this file to .env for local development
# NEVER commit the actual .env file

# OpenCode Zen API Key — REQUIRED
# Get yours at: https://opencode.ai (create account → API Keys)
# For production: use `wrangler secret put OPENCODE_API_KEY`
OPENCODE_API_KEY=your-api-key-here

# These are also in wrangler.toml but can be overridden locally:
# AI_ENABLED=true
# AI_MODEL=deepseek-v4-flash-free
# ALLOWED_ORIGIN=http://localhost:5500
