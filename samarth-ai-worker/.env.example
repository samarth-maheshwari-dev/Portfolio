# Samarth AI Worker — local secrets for `wrangler dev`
# Copy to .dev.vars (never commit it). Production: `npx wrangler secret put <NAME>`.
#
# Both are optional: without them the worker uses Cloudflare Workers AI only
# (no key needed), and falls back to answering straight from knowledge.md.

# https://console.groq.com/keys
GROQ_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
